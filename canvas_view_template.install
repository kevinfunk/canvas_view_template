<?php

/**
 * @file
 * Install, update and uninstall functions for the Canvas View Templates module.
 */

use Drupal\canvas\AutoSave\AutoSaveManager;
use Drupal\canvas\Entity\Component;
use Drupal\canvas\Entity\ComponentTreeConfigEntityBase;
use Drupal\canvas\Entity\Folder;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateCondition;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateEmpty;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateFeedIcons;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateField;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateItemLink;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplatePlaceholder;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateRepeater;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateSummary;
use Drupal\canvas_view_template\Plugin\Canvas\ComponentSource\ViewTemplateTitle;

/**
 * Implements hook_uninstall().
 *
 * Deletes the Components via the entity API, which triggers Folder cleanup.
 */
function canvas_view_template_uninstall(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  $local_ids = [
    ViewTemplatePlaceholder::VIEW_ROWS_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_EXPOSED_FILTERS_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_PAGER_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_ITEM_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_HEADER_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_FOOTER_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_MORE_LOCAL_ID,
    ViewTemplatePlaceholder::VIEW_ATTACHMENTS_LOCAL_ID,
  ];
  foreach ($local_ids as $local_id) {
    $placeholder = Component::load(ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.' . $local_id);
    $placeholder?->delete();
  }
  $empty = Component::load(ViewTemplateEmpty::SOURCE_PLUGIN_ID . '.' . ViewTemplateEmpty::LOCAL_ID);
  $empty?->delete();
  $title = Component::load(ViewTemplateTitle::SOURCE_PLUGIN_ID . '.' . ViewTemplateTitle::LOCAL_ID);
  $title?->delete();
  $field = Component::load(ViewTemplateField::SOURCE_PLUGIN_ID . '.' . ViewTemplateField::LOCAL_ID);
  $field?->delete();
  $item_link = Component::load(ViewTemplateItemLink::SOURCE_PLUGIN_ID . '.' . ViewTemplateItemLink::LOCAL_ID);
  $item_link?->delete();
  $condition = Component::load(ViewTemplateCondition::SOURCE_PLUGIN_ID . '.' . ViewTemplateCondition::LOCAL_ID);
  $condition?->delete();
  $feed_icons = Component::load(ViewTemplateFeedIcons::SOURCE_PLUGIN_ID . '.' . ViewTemplateFeedIcons::LOCAL_ID);
  $feed_icons?->delete();
  $summary = Component::load(ViewTemplateSummary::SOURCE_PLUGIN_ID . '.' . ViewTemplateSummary::LOCAL_ID);
  $summary?->delete();
  $repeater = Component::load(ViewTemplateRepeater::SOURCE_PLUGIN_ID . '.' . ViewTemplateRepeater::LOCAL_ID);
  $repeater?->delete();
  // Canvas does not prune empty folders.
  $folder = Folder::loadByNameAndConfigEntityTypeId(ViewTemplatePlaceholder::LIBRARY_FOLDER_NAME, Component::ENTITY_TYPE_ID);
  if ($folder !== NULL && $folder->get('items') === []) {
    $folder->delete();
  }
}

/**
 * Adds the header, footer, empty and title components.
 */
function canvas_view_template_update_10002(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
}

/**
 * Makes "View empty" a container with a slot.
 *
 * Replaces the old placeholder version.
 */
function canvas_view_template_update_10003(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
  // Move first: deleting the old component deletes everything depending on it.
  _canvas_view_template_move_placements(
    ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.view_empty',
    ViewTemplateEmpty::SOURCE_PLUGIN_ID . '.' . ViewTemplateEmpty::LOCAL_ID,
    [],
  );
  Component::load(ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.view_empty')?->delete();
}

/**
 * Moves placements of the old "View empty" placeholder to the new component.
 */
function canvas_view_template_update_10004(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
  _canvas_view_template_move_placements(
    ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.view_empty',
    ViewTemplateEmpty::SOURCE_PLUGIN_ID . '.' . ViewTemplateEmpty::LOCAL_ID,
    [],
  );
}

/**
 * Makes "View title" a component with an "Element" setting.
 *
 * Existing placements move to it with the default level (h2).
 */
function canvas_view_template_update_10005(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
  _canvas_view_template_move_placements(
    ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.view_title',
    ViewTemplateTitle::SOURCE_PLUGIN_ID . '.' . ViewTemplateTitle::LOCAL_ID,
    [ViewTemplateTitle::INPUT_ELEMENT => ViewTemplateTitle::DEFAULT_ELEMENT],
  );
  Component::load(ViewTemplatePlaceholder::SOURCE_PLUGIN_ID . '.view_title')?->delete();
}

/**
 * Stops Views depending on the templates they use.
 */
function canvas_view_template_update_10006(): void {
  foreach (\Drupal::entityTypeManager()->getStorage('view')->loadMultiple() as $view) {
    foreach ($view->get('display') as $display) {
      $style = $display['display_options']['style'] ?? [];
      if (($style['type'] ?? NULL) === 'canvas_view_template') {
        $view->save();
        break;
      }
    }
  }
}

/**
 * Renames "View empty" to "View no results" and the library folder.
 *
 * Labels only; component ids stay the same.
 */
function canvas_view_template_update_10007(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
  $component = Component::load(ViewTemplateEmpty::SOURCE_PLUGIN_ID . '.' . ViewTemplateEmpty::LOCAL_ID);
  if ($component !== NULL && $component->label() !== 'View no results') {
    $component->set('label', 'View no results')->save();
  }
  $folder = Folder::loadByNameAndConfigEntityTypeId('View Template', Component::ENTITY_TYPE_ID);
  $folder?->set('name', ViewTemplatePlaceholder::LIBRARY_FOLDER_NAME)->save();
}

