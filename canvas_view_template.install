/**
 * Renames "View row link" to "View item link", keeping its placements.
 */
function canvas_view_template_update_10016(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'canvas_view_template');
  $old_id = 'canvas_view_template_row_link.view_row_link';
  _canvas_view_template_move_placements(
    $old_id,
    ViewTemplateItemLink::SOURCE_PLUGIN_ID . '.' . ViewTemplateItemLink::LOCAL_ID,
    static fn (array $inputs): array => [
      ViewTemplateItemLink::INPUT_OPEN => $inputs['open'] ?? ViewTemplateItemLink::OPEN_SAME,
    ],
  );
  // Its source plugin no longer exists, so remove it as plain config and from
  // its folder.
  $old_config = \Drupal::configFactory()->getEditable('canvas.component.' . $old_id);
  if (!$old_config->isNew()) {
    $old_config->delete();
  }
  foreach (Folder::loadMultiple() as $folder) {
    $items = $folder->get('items');
    if (\is_array($items) && \in_array($old_id, $items, TRUE)) {
      $folder->set('items', \array_values(\array_diff($items, [$old_id])))->save();
    }
  }
}

/**
 * Removes components that no longer exist from this module's library folder.
 */
function canvas_view_template_update_10017(): void {
  $storage = \Drupal::entityTypeManager()->getStorage(Component::ENTITY_TYPE_ID);
  foreach (Folder::loadMultiple() as $folder) {
    if ($folder->get('configEntityTypeId') !== Component::ENTITY_TYPE_ID) {
      continue;
    }
    $items = $folder->get('items');
    $stale = \array_filter($items, static fn (string $id): bool => \str_starts_with($id, 'canvas_view_template_') && $storage->load($id) === NULL);
    if ($stale !== []) {
      $folder->set('items', \array_values(\array_diff($items, $stale)))->save();
    }
  }
}

/**
 * Points every placement of one component at another, in trees and drafts.
 *
 * Covers every config entity with a component tree (view templates, patterns,
 * content and page templates, page regions), not content entities such as
 * Canvas pages. A placement of a missing component stops the editor loading
 * the tree.
 *
 * @param string $old_id
 *   The Component id being replaced (it may already be gone).
 * @param string $new_id
 *   The Component id that replaces it (it must exist).
 * @param array|callable $new_inputs
 *   The `inputs` for moved placements, or a function mapping the old inputs.
 */
function _canvas_view_template_move_placements(string $old_id, string $new_id, array|callable $new_inputs): void {
  $new_component = Component::load($new_id);
  if ($new_component === NULL) {
    return;
  }
  $new_version = $new_component->getActiveVersion();
  $rewrite = static function (array $tree) use ($old_id, $new_id, $new_version, $new_inputs): ?array {
    $changed = FALSE;
    foreach ($tree as $key => $item) {
      if (($item['component_id'] ?? NULL) === $old_id) {
        $tree[$key]['component_id'] = $new_id;
        $tree[$key]['component_version'] = $new_version;
        $tree[$key]['inputs'] = \is_callable($new_inputs) ? $new_inputs($item['inputs'] ?? []) : $new_inputs;
        $changed = TRUE;
      }
    }
    return $changed ? $tree : NULL;
  };

  $auto_save_manager = \Drupal::service(AutoSaveManager::class);
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach ($entity_type_manager->getDefinitions() as $entity_type_id => $definition) {
    if (!\is_subclass_of($definition->getClass(), ComponentTreeConfigEntityBase::class)) {
      continue;
    }
    foreach ($entity_type_manager->getStorage($entity_type_id)->loadMultiple() as $entity) {
      // Read the draft first: saving a Canvas config entity's tree discards it.
      $draft = $auto_save_manager->getAutoSaveEntity($entity, TRUE);
      // Raw data: the tree may point at a missing component, which would fail
      // if hydrated.
      $tree = $rewrite($entity->toArray()['component_tree'] ?? []);
      if ($tree !== NULL) {
        $entity->set('component_tree', $tree)->save();
      }
      if ($draft->isEmpty()) {
        continue;
      }
      $draft_tree = $rewrite($draft->entity->toArray()['component_tree'] ?? []);
      if ($draft_tree !== NULL) {
        $draft->entity->set('component_tree', $draft_tree);
      }
      if ($draft_tree !== NULL || $auto_save_manager->getAutoSaveEntity($entity, TRUE)->isEmpty()) {
        // The draft's owner and time become the current user and now: the
        // AutoSaveManager API has no way to keep them.
        $auto_save_manager->saveEntity($draft->entity, $draft->clientId);
      }
    }
  }
}
