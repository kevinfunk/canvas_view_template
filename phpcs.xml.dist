<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by the drupal.org GitLab "phpcs" job. Run locally with `vendor/bin/phpcs`
     from the module directory. -->
<ruleset name="canvas_view_template">
  <description>Drupal coding standards for Canvas View Template.</description>

  <file>.</file>
  <arg name="extensions" value="php,inc,module,install,info,test,profile,theme,engine,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/.cache/*</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
